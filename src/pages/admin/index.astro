---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { readContent } from '../../utils/store';

export const prerender = false;

const { projects, services, team, clients } = await readContent();

const cards = [
    { href: '/admin/projects', label: 'PROJECTS', count: projects.length, note: 'CASE FILES SHOWN ON THE HOMEPAGE & /PROJECTS/[SLUG]' },
    { href: '/admin/services', label: 'SERVICES', count: services.length, note: 'THE 02 / SERVICES LIST' },
    { href: '/admin/team', label: 'TEAM', count: team.length, note: 'THE 06 / THE LAB SECTION' },
    { href: '/admin/clients', label: 'CLIENTS', count: clients.length, note: 'THE 04 / CLIENTS WALL' },
];
---

<AdminLayout title="Dashboard" active="dashboard">
    <p class="text-[10px] tracking-[0.3em] text-concrete-600 uppercase">[ ADMIN / CONTROL ROOM ]</p>
    <h1 class="mt-3 font-display text-5xl uppercase md:text-6xl">MANAGE THE LAB</h1>

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
            cards.map((card) => (
                <a
                    href={card.href}
                    class="group block border-2 border-concrete-900 bg-concrete-50 p-6 shadow-hard transition-all hover:shadow-hard-red"
                >
                    <p class="text-[10px] tracking-[0.25em] text-concrete-600 uppercase group-hover:text-signal">
                        [ {card.label} ]
                    </p>
                    <p class="mt-3 font-display text-6xl leading-none group-hover:text-signal">
                        {String(card.count).padStart(2, '0')}
                    </p>
                    <p class="mt-3 text-[10px] leading-relaxed tracking-widest text-concrete-600 uppercase">
                        {card.note}
                    </p>
                </a>
            ))
        }
    </div>

    <p class="mt-8 max-w-xl text-xs leading-relaxed tracking-widest text-concrete-600 uppercase">
        EVERYTHING HERE EDITS THE LIVE SITE. CHANGES SAVE TO THE SERVER INSTANTLY — NO REBUILD.
        REFRESH THE PUBLIC SITE TO SEE THEM.
    </p>
</AdminLayout>
