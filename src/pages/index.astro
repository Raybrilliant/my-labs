---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/astro/Nav.astro";
import Marquee from "../components/astro/Marquee.astro";
import Projects from "../components/astro/Projects.astro";
import Clients from "../components/astro/Clients.astro";
import Team from "../components/astro/Team.astro";
import Contact from "../components/astro/Contact.astro";
import Footer from "../components/astro/Footer.astro";
import Hero from "../components/svelte/Hero.svelte";
import Services from "../components/svelte/Services.svelte";
import Process from "../components/svelte/Process.svelte";
import { readContent } from "../utils/store";

// Server-rendered so admin edits (projects/services/team) show live.
export const prerender = false;

const { services, clients } = await readContent();
---

<BaseLayout
    title="Raybrilliant Labs — Software Development Studio"
    description="Raybrilliant Labs is a software development studio in Probolinggo, Indonesia, building websites, mobile apps and MVPs that don't look like everyone else's. Bold design, clean engineering, shipped fast."
>
    <Nav />

    <main>
        <Hero client:load />

        <Marquee
            items={[
                "WEB DEVELOPMENT",
                "PRODUCT DESIGN",
                "MOBILE APPS",
                "MVP DEV",
                "CONSULTING",
            ]}
            duration="30s"
        />

        <Services client:visible services={services} />

        <Projects />

        <Clients clients={clients} />

        <Marquee
            items={["DISCOVER", "DESIGN", "DEVELOP", "DEPLOY", "SUPPORT"]}
            duration="26s"
            reverse={true}
        />

        <Process client:visible />

        <Team />

        <Contact />
    </main>

    <Footer />
</BaseLayout>
