---
import SectionHeading from "./SectionHeading.astro";
import JoinForm from "../svelte/JoinForm.svelte";
import { readContent } from "../../utils/store";

const { team } = await readContent();
---

<section
    id="lab"
    class="section-pad border-b-2 border-concrete-900 bg-concrete-50"
>
    <div class="shell">
        <SectionHeading
            index="06"
            label="THE LAB"
            lines={["SMALL CREW,", "BIG OUTPUT"]}
            note="NO ACCOUNT MANAGERS. YOU TALK TO THE PEOPLE WHO BUILD YOUR PRODUCT."
        />

        <div class="grid gap-10 md:grid-cols-12 md:gap-12">
            {team.map((member, i) => (
                <article
                    class={`group md:col-span-5 ${i % 2 === 1 ? 'md:col-start-8' : ''}`}
                    data-reveal
                >
                    <div class="neon-portrait shadow-hard border-2 border-concrete-900">
                        <div class="duotone">
                            <img
                                src={member.img}
                                alt={member.alt}
                                width="600"
                                height="750"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                    </div>
                    <div class="mt-5 border-t-2 border-concrete-900 pt-4">
                        <h3 class="font-display text-3xl text-concrete-900 uppercase">
                            {member.name}
                        </h3>
                        <p class="mt-1 font-mono text-xs tracking-[0.25em] text-signal uppercase">
                            {member.role}
                        </p>
                        <p class="mt-4 max-w-md text-sm leading-relaxed text-concrete-600">
                            {member.bio}
                        </p>
                    </div>
                </article>
            ))}

            <!-- Manifesto + open seat -->
            <div class="flex flex-col gap-10 md:col-span-7">
                <blockquote
                    class="border-2 border-concrete-900 bg-concrete-100 p-7 md:p-10"
                    data-reveal
                >
                    <p class="font-display text-concrete-900 uppercase leading-[1.02] text-[clamp(1.5rem,3.2vw,2.6rem)]">
                        “MOST AGENCIES SELL YOU A LOOK. WE BUILD THE THING —
                        <span class="text-signal">THEN</span> MAKE IT LOOK
                        UNFAIRLY GOOD.”
                    </p>
                    <footer class="mt-5 font-mono text-xs tracking-[0.25em] text-concrete-600 uppercase">
                        — THE LAB'S ONLY SALES PITCH
                    </footer>
                </blockquote>

                <JoinForm client:visible />
            </div>
        </div>
    </div>
</section>

<script>
    // Neon tube power state — same behavior as the hero headline: hover
    // strikes the portrait on (.neon-live), leaving lets it sputter out
    // (.neon-dying) instead of snapping back to mono.
    const canFlicker = window.matchMedia('(prefers-reduced-motion: no-preference)');

    for (const frame of document.querySelectorAll<HTMLElement>('.neon-portrait')) {
        frame.addEventListener('mouseenter', () => {
            frame.classList.add('neon-live');
            frame.classList.remove('neon-dying');
        });
        frame.addEventListener('mouseleave', () => {
            frame.classList.remove('neon-live');
            if (canFlicker.matches) frame.classList.add('neon-dying');
        });
        frame.addEventListener('animationend', (e) => {
            if ((e as AnimationEvent).animationName === 'np-glow-die') {
                frame.classList.remove('neon-dying');
            }
        });
    }
</script>
