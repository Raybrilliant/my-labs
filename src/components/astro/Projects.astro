---
import SectionHeading from './SectionHeading.astro';
import { readContent } from '../../utils/store';

const { projects } = await readContent();
---

<section id="projects" class="section-pad border-b-2 border-concrete-900 bg-concrete-50">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        index="03"
        label="PROJECTS"
        lines={['SELECTED', 'WORK_']}
      />
      <p
        class="mb-14 hidden font-mono text-xs tracking-widest text-concrete-600 md:mb-20 lg:block"
        data-reveal
      >
        [ EVERY BUILD: BLEEDING-EDGE, FAST, EFFICIENT ]
      </p>
    </div>

    <div class="grid grid-cols-1 gap-x-10 gap-y-16 md:grid-cols-12">
      {
        projects.map((project, i) => {
          const autoSpan =
            i % 4 === 1
              ? 'md:col-span-5 md:mt-28'
              : i % 4 === 2
                ? 'md:col-span-5'
                : i % 4 === 3
                  ? 'md:col-span-7 md:mt-16'
                  : 'md:col-span-7';
          return (
            <a
              href={`/projects/${project.slug}`}
              class:list={['project-card group', project.span ?? autoSpan]}
              data-cursor-label="VIEW →"
              data-reveal
            >
            <article>
              <div class="shadow-hard border-2 border-concrete-900 bg-concrete-100 transition-all duration-200 group-hover:shadow-hard-red">
                <div class="overflow-hidden">
                  <img
                    src={project.img}
                    alt={project.alt}
                    width="1200"
                    height="900"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full object-cover transition-transform duration-300 will-change-transform group-hover:scale-[1.04] group-hover:-rotate-[0.5deg]"
                  />
                </div>
                <span class="absolute top-0 left-0 border-r-2 border-b-2 border-concrete-900 bg-signal px-2 py-1 font-mono text-[10px] tracking-widest text-concrete-50">
                  {project.year}
                </span>
              </div>

              <div class="mt-5 flex items-start justify-between gap-4 border-t-2 border-concrete-900 pt-3">
                <h3 class="font-display text-2xl text-concrete-900 uppercase transition-colors duration-150 group-hover:text-signal md:text-3xl">
                  {project.name}
                </h3>
                <span class="font-mono text-lg text-concrete-900 transition-all duration-150 group-hover:translate-x-1 group-hover:text-signal" aria-hidden="true">
                  ↗
                </span>
              </div>
              <p class="mt-2 font-mono text-xs tracking-widest text-concrete-600">
                [{project.type} — CASE FILE]
              </p>
              <p class="mt-3 max-w-xl text-sm leading-relaxed text-concrete-600">
                {project.desc}
              </p>
            </article>
          </a>
          );
        })
      }
    </div>
  </div>
</section>
