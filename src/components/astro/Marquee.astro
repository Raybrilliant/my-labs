---
interface Props {
  items: string[];
  duration?: string;
  dark?: boolean;
  reverse?: boolean;
  class?: string;
}

const { items, duration = '28s', dark = false, reverse = false, class: cls } = Astro.props;
---

<div
  class:list={[
    'overflow-hidden border-y-2 border-concrete-900 select-none',
    dark ? 'bg-concrete-900 text-concrete-50' : 'bg-concrete-50 text-concrete-900',
    cls,
  ]}
  aria-hidden="true"
>
  <div
    class="flex w-max animate-marquee will-change-transform"
    style={`--marquee-duration: ${duration}; ${reverse ? 'animation-direction: reverse;' : ''}`}
  >
    {
      [0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {items.map((item) => (
            <span class="flex items-center">
              <span class="px-6 font-display text-2xl tracking-wide uppercase md:px-10 md:text-4xl">
                {item}
              </span>
              <span class="font-mono text-xl text-signal md:text-2xl">✦</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
